#!/bin/bash
#
# explorer - command-line launcher for the Explorer app.
#
#   explorer            open a new window
#   explorer <dir>      open the directory in a new window
#   explorer <file>     reveal and select the file in its enclosing folder
#
# Hands off to the app through its registered URL schemes (explorer:// and
# explorerreveal://), which the app receives in AppDelegate URL handler.
# open discards the caller's working directory, so paths are resolved to an
# absolute path here before being turned into a URL.

set -euo pipefail

usage() {
	cat >&2 <<-'EOF'
		Usage: explorer [path]
		  (no path)          open a new window
		  path to a folder   open it in a new window
		  path to a file     reveal and select it
	EOF
	exit 64
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]
then
	usage
fi

if [ "$#" -gt 1 ]
then
	usage
fi

if [ "$#" -eq 0 ]
then
	open "explorer:///%23"
	exit 0
fi

target=$1

if [ -d "$target" ]
then
	abs=$(cd "$target" && pwd -P)
	if [ "${abs: -1}" != "/" ]
	then
		abs="$abs/"
	fi
	scheme=explorer
elif [ -e "$target" ]
then
	dir=$(cd "$(dirname "$target")" && pwd -P)
	if [ "${dir: -1}" != "/" ]
	then
		abs="$dir/$(basename "$target")"
	else
		abs="$dir$(basename "$target")"
	fi
	scheme=explorerreveal
else
	echo "explorer: no such file or directory: $target" >&2
	exit 66
fi

urlencode() {
	local LC_ALL=C s=$1 out="" c="" i=0 n=0
	local len=${#s}
	while [ $i -lt $len ]
	do
		c=${s:i:1}
		case $c in
			[a-zA-Z0-9.~_/-])
				out+=$c
				;;
			*)
				printf -v n '%d' "'$c"
				out+=$(printf '%%%02X' "$((n & 0xFF))")
				;;
		esac
		i=$((i + 1))
	done
	printf '%s' "$out"
}

open "$scheme://$(urlencode "$abs")"
